{
  "identifier": "run.vineyard.pluginpacks.domain_recon",
  "content_type": "vineyard:pluginpack",
  "name": "Domain Recon",
  "version": "2.1.0",
  "description": "Passive, keyless domain enrichment: per-record DNS lookups over DoH (A, AAAA, CNAME, MX, NS, TXT, CAA), RDAP registration data, and Certificate Transparency subdomain discovery from crt.sh (web) and crt.name (desktop-only).",
  "author": {
    "name": "VINEYARD",
    "url": "https://github.com/Vineyard-Intelligence"
  },
  "license": "Apache-2.0",
  "icon": "globe",
  "platforms": {
    "primary": "web",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    }
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.dns_lookup_a",
      "content_type": "vineyard:plugin",
      "name": "DNS Lookup (A Record)",
      "version": "1.0.0",
      "description": "Resolves each selected Domain's A records over DNS-over-HTTPS and adds them to the graph. Keyless, no server.",
      "icon": "network",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "domain"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "ip_address"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://cloudflare-dns.com/dns-query",
            "methods": [
              "GET"
            ],
            "purpose": "Resolve DNS records over DoH."
          },
          {
            "endpoint": "https://dns.google/resolve",
            "methods": [
              "GET"
            ],
            "purpose": "Fallback DoH resolver."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
