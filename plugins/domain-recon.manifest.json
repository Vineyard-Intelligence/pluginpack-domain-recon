        ],
        "produces": []
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:update"
        ],
        "network": [
          {
            "endpoint": "https://rdap.org/",
            "methods": [
              "GET"
            ],
            "purpose": "RDAP bootstrap \u2192 authoritative registry (both send CORS *)."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
    {
      "identifier": "run.vineyard.plugins.crtsh_subdomains",
      "content_type": "vineyard:plugin",
      "name": "Certificate Transparency Subdomains",
      "version": "1.0.0",
      "description": "Discovers subdomains of each selected Domain from public Certificate Transparency logs (crt.sh) and adds them as Domain nodes. Passive, keyless, no server. Capped at 150 per domain.",
