{
  "identifier": "run.vineyard.pluginpacks.domain_recon",
  "content_type": "vineyard:pluginpack",
  "name": "Domain Recon",
  "version": "2.1.2",
  "description": "Enriches Domain nodes with DNS records (A, AAAA, CNAME, MX, NS, TXT, CAA), RDAP registration data, and Certificate Transparency subdomains from crt.sh and crt.name (desktop only).",
  "author": {
    "name": "VINEYARD",
    "url": "https://vineyard.run"
  },
  "license": "Apache-2.0",
  "icon": "globe",
  "platforms": {
    "primary": "web",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    }
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.dns_lookup_a",
      "content_type": "vineyard:plugin",
      "name": "DNS Lookup (A Record)",
      "version": "1.0.1",
      "description": "Resolves the A records of each selected Domain and adds the IPv4 addresses as IP Address nodes linked by \"resolves to\".",
      "icon": "network",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "domain"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "ip_address"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://cloudflare-dns.com/dns-query",
            "methods": [
              "GET"
            ],
            "purpose": "Resolve DNS records over DoH."
          },
          {
            "endpoint": "https://dns.google/resolve",
            "methods": [
              "GET"
            ],
            "purpose": "Fallback DoH resolver."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
